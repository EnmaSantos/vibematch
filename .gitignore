# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.sql
!supabase/
!supabase/migrations/
!supabase/migrations/*.sql

# Native development
mobile/ios/.build/
mobile/ios/DerivedData/
mobile/ios/Config/Local.xcconfig
**/xcuserdata/
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/local.properties
mobile/android/**/build/
mobile/android/*.jks
mobile/android/*.p12
